# Allowlist: project data and machine-specific backups stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/pyproject.toml
!/MANIFEST.in
!/uv.lock
!/tests/
!/scripts/
!/tools/
/tools/*
!/tools/git_content_filter.py
!/latest/
/latest/*
!/latest/python/
!/latest/native/
!/latest/native-source/
!/latest/docs/
/latest/docs/*
!/latest/docs/工具目录.md
!/latest/docs/工具目录.json
!/latest/docs/DEPLOYMENT.md
!/latest/docs/PORTABILITY-VALIDATION.md
!/latest/config/
/latest/config/*
!/latest/config/autocad-mcp.example.json
!/latest/config/autocad-mcp.example.toml
!/latest/config/dependencies.lock.txt
!/latest/metadata/
/latest/metadata/*
!/latest/metadata/METADATA
!/latest/metadata/entry_points.txt
!/latest/metadata/licenses/
**/__pycache__/
**/*.pyc
**/*.pyo
**/bin/
**/obj/
**/*.bak
**/*.log
**/.env
**/.env.*
**/*.egg-info/

# README illustrations (synthetic data only)
!/latest/docs/media/
/latest/docs/media/*
!/latest/docs/media/*.gif
