{
  "mcp_servers": {
    "autocad-mcp": {
      "command": "C:\\Users\\YOUR_USER\\.local\\bin\\autocad-mcp.exe",
      "startup_timeout_sec": 120,
      "env": {
        "DISABLED_TOOLS": "drawing_deliver,drawing_finalize,validation_check",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "AUTOCAD_MCP_BACKEND": "com",
        "CAD_PROGID": "AutoCAD.Application.25.1",
        "ALLOWED_PATHS": "D:\\YOUR_CAD_WORKSPACE",
        "TOOL_PROFILE": "full",
        "TOOL_PACKS": "all",
        "DISCOVERY_MODE": "search",
        "ENABLE_3D": "true"
      }
    }
  }
}
